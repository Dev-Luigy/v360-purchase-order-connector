{
  "name": "v360-purchase-order-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run generate && npm run schema:check && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "preflight": "node scripts/preflight-docker.mjs",
    "preup": "npm run preflight",
    "up": "docker compose up --build",
    "predb:up": "npm run preflight",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "generate": "prisma generate",
    "prebuild": "npm run generate",
    "pretest": "npm run generate",
    "schema:check": "prisma format --check",
    "coverage": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=1 --experimental-test-coverage \"tests/**/*.test.ts\"",
    "test:integration": "node --env-file=.env --import tsx --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "audit:fidelity": "node scripts/audit-fidelity.mjs",
    "audit:policy": "node scripts/audit-policy.mjs",
    "evidence": "node scripts/evidence.mjs",
    "validate:http": "node scripts/validate-fix-14-http.mjs",
    "validate:sweep": "node scripts/validate-sweep-under-load.mjs",
    "validate:volume": "node scripts/volume-check.mjs"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-zod": "1.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cpf-cnpj-validator": "2.1.2",
    "csv-parse": "^7.0.3",
    "decimal.js": "^10.6.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "stream-json": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "fast-check": "4.10.2",
    "prettier": "^3.9.9",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
