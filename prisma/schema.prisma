generator client {
  provider = "prisma-client"
  output   = "../src/infrastructure/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum PurchaseOrderStatus {
  aberto
  encerrado
  bloqueado

  @@map("purchase_order_status")
}

enum ConferenceOutcome {
  aprovada
  reprovada

  @@map("conference_outcome")
}

enum DivergenceCode {
  FORNECEDOR_DIVERGENTE
  PEDIDO_NAO_ABERTO
  MATERIAL_NAO_ENCONTRADO
  MATERIAL_AMBIGUO
  QUANTIDADE_NAO_POSITIVA
  QUANTIDADE_ACIMA_DO_SALDO
  VALOR_TOTAL_DIVERGENTE

  @@map("divergence_code")
}

model PurchaseOrder {
  /// UUID v7 mantém o cursor ordenável no tempo.
  id       String @id @default(uuid(7)) @db.Uuid
  clientId String @map("client_id") @db.VarChar(64)

  /// Identidade externa composta, pois números se repetem entre clientes.
  externalNumber String @map("external_number") @db.VarChar(64)

  supplierTaxId String              @map("supplier_tax_id") @db.Char(14)
  supplierName  String              @map("supplier_name") @db.VarChar(256)
  currency      String              @db.Char(3)
  status        PurchaseOrderStatus
  issuedOn      DateTime            @map("issued_on") @db.Date

  ingestionVersion Int      @default(1) @map("ingestion_version")
  ingestedAt       DateTime @map("ingested_at") @db.Timestamptz(3)

  /// Persistido porque comparar duas colunas não aproveita índice B-tree.
  hasPendingBalance Boolean @map("has_pending_balance")

  items       PurchaseOrderItem[]
  conferences Conference[]

  // O índice sem `status` cobre a consulta por cliente sem esse filtro.
  @@unique([clientId, externalNumber])
  @@index([clientId, id])
  @@index([clientId, status, id])
  @@index([supplierTaxId, id])
  @@index([externalNumber, id])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id              String @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid

  externalLine Int    @map("external_line")
  material     String @db.VarChar(128)
  description  String @db.VarChar(512)

  /// O fator converte unidade de compra em unidade de consumo.
  purchaseUnit     String  @map("purchase_unit") @db.VarChar(16)
  conversionFactor Decimal @map("conversion_factor") @db.Decimal(30, 6)

  quantityOrdered  Decimal @map("quantity_ordered") @db.Decimal(30, 6)
  quantityReceived Decimal @map("quantity_received") @db.Decimal(30, 6)

  quantityPending Decimal @map("quantity_pending") @db.Decimal(30, 6)

  unitPrice     Decimal   @map("unit_price") @db.Decimal(30, 6)
  lineCreatedOn DateTime? @map("line_created_on") @db.Date

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, externalLine])
  @@index([purchaseOrderId, material])
  @@map("purchase_order_item")
}

model Conference {
  id              String @id @default(uuid(7)) @db.Uuid
  purchaseOrderId String @map("purchase_order_id") @db.Uuid

  /// Versão usada na conferência, para preservar o sentido do histórico.
  purchaseOrderIngestionVersion Int @map("purchase_order_ingestion_version")

  clientId  String            @map("client_id") @db.VarChar(64)
  checkedAt DateTime          @map("checked_at") @db.Timestamptz(3)
  outcome   ConferenceOutcome

  invoice Json @db.JsonB

  /// O histórico não pode ser apagado em cascata com o pedido.
  purchaseOrder PurchaseOrder          @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  divergences   ConferenceDivergence[]

  @@index([clientId, id])
  @@index([checkedAt])
  @@index([purchaseOrderId])
  @@map("conference")
}

/// Tabela própria para agrupar e indexar ocorrências por código.
model ConferenceDivergence {
  id           String @id @default(uuid(7)) @db.Uuid
  conferenceId String @map("conference_id") @db.Uuid

  /// Preserva a ordem produzida pelo domínio.
  position Int

  code  DivergenceCode
  field String         @db.VarChar(128)

  invoiceLineIndex  Int?    @map("invoice_line_index")
  purchaseOrderLine Int?    @map("purchase_order_line")
  expected          String? @db.VarChar(512)
  received          String? @db.VarChar(512)

  conference Conference @relation(fields: [conferenceId], references: [id], onDelete: Cascade)

  @@unique([conferenceId, position])
  @@index([code])
  @@map("conference_divergence")
}

/// Itens que chegaram antes do cabeçalho deles (ADR-008).
///
/// O Delta entrega pedidos e itens em duas consultas independentes, sem
/// garantia de retratarem o mesmo instante. O item espera aqui em vez de virar
/// pedido inventado — sem fornecedor e sem situação, ele nunca poderia ser
/// conferido — e sai daqui quando o cabeçalho chega.
model IngestionStaging {
  id String @id @default(uuid(7)) @db.Uuid

  clientId       String @map("client_id") @db.VarChar(64)
  externalNumber String @map("external_number") @db.VarChar(64)
  externalLine   Int    @map("external_line")

  /// De qual carga esta linha veio. Faz parte da **identidade**: duas cargas
  /// podem ter a mesma linha do mesmo pedido em espera ao mesmo tempo, cada
  /// uma dona da sua (REVIEW-13, R13-01).
  ingestionId String @map("ingestion_id") @db.Uuid

  /// O item já normalizado; quem reconcilia não conhece o formato do cliente.
  item Json
  /// O conteúdo original, para auditoria e para o relatório da carga.
  raw  String

  stagedAt DateTime @map("staged_at") @db.Timestamptz(3)

  /// A carga que gravou esta linha já terminou de ler?
  ///
  /// Enquanto `false`, a linha é invisível para a reconciliação de outra
  /// requisição: uma carga em andamento não pode ter o prefixo dela consumido
  /// por um cabeçalho concorrente (REVIEW-14, R14-01).
  publicada Boolean @default(false)

  @@unique([clientId, ingestionId, externalNumber, externalLine], map: "ingestion_staging_owner_line_key")
  @@index([clientId, ingestionId], map: "ingestion_staging_client_ingestion_idx")
  @@index([clientId, externalNumber], map: "ingestion_staging_client_order_idx")
  @@map("ingestion_staging")
}
