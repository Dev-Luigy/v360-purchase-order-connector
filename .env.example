NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Portas publicadas no host pelo Compose. Dentro da rede do Compose o banco
# continua em 5432; 55432 é o padrão no host para nunca disputar a porta de um
# PostgreSQL que já esteja rodando na máquina. `npm run preflight` verifica.
API_PORT=3000
DB_PORT=55432

DATABASE_URL=postgresql://v360:v360@localhost:55432/v360

# Quem pode informar o IP de origem por `X-Forwarded-For`. Vazio ignora o
# cabeçalho, que é o certo sem proxy na frente. Atrás de um proxy no mesmo
# host, use `loopback`: sem isso, todos os clientes chegam com o IP do proxy e
# dividem uma quota só do teto por origem. Veja deploy/README.md.
TRUST_PROXY=
